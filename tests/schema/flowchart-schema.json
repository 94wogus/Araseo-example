{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Araseo Flowchart Schema",
  "description": "JSON schema for flowchart visualization in Araseo",
  "type": "object",
  "required": ["graph"],
  "properties": {
    "graph": {
      "type": "object",
      "required": ["directed", "label", "type", "nodes", "edges"],
      "properties": {
        "directed": {
          "type": "boolean",
          "description": "Whether the graph is directed"
        },
        "label": {
          "type": "string",
          "description": "Title or label of the flowchart"
        },
        "type": {
          "type": "string",
          "enum": ["flowchart", "workflow"],
          "description": "Type of the diagram"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata about the graph"
        },
        "nodes": {
          "type": "object",
          "description": "Collection of nodes in the graph",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_-]*$": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Display label for the node"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "shape": {
                      "type": "string",
                      "enum": ["rectangle", "oval", "diamond", "parallelogram", "circle", "cylinder", "hexagon"],
                      "description": "Visual shape of the node"
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Hex color code for the node"
                    }
                  }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "description": "Collection of edges connecting nodes",
          "items": {
            "type": "object",
            "required": ["source", "target", "relation"],
            "properties": {
              "source": {
                "type": "string",
                "description": "Source node identifier"
              },
              "target": {
                "type": "string",
                "description": "Target node identifier"
              },
              "relation": {
                "type": "string",
                "description": "Relationship type"
              },
              "directed": {
                "type": "boolean",
                "description": "Whether this edge is directed"
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Label for the edge"
                  },
                  "style": {
                    "type": "string",
                    "enum": ["solid", "dashed", "dotted"],
                    "description": "Line style for the edge"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
